{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": false,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "rootDirs": ["src/"],
    "downlevelIteration": false,
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}