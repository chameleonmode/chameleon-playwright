{
  "name": "chameleon-playwright",
  "version": "1.0.0",
  "description": "Dynamic Playwright test runner",
  "type": "module",
  "scripts": {
    "node:ts": "node --loader ts-node/esm",
    "dev": "npm run node:ts src/index.ts",
    "dev:watch": "nodemon --watch 'src/**/*.ts' --exec 'npm run node:ts' src/index.ts",
    "reddit:run": "npm run node:ts src/local.ts -- reddit",
    "reddit:login-credentials": "npm run reddit:run login/credentials.ts '{\"email\":\"example@gmail.com\", \"password\":\"pass@word\"}'",
    "reddit:login-google": "npm run reddit:run login/google.ts '{\"email\":\"example@gmail.com\", \"password\":\"pass@word\"}'",
    "reddit:comment-on-comment": "npm run reddit:run post/reply-to-comment.ts '{\"search\":\"playwright\"}'",
    "reddit:comment-on-title": "npm run reddit:run post/comment-on-title.ts '{\"search\":\"playwright\"}'",
    "reddit:vote-subreddit": "npm run reddit:run subreddit/vote.ts '{\"search\":\"mumbai\"}'",
    "reddit:post-subreddit": "npm run reddit:run subreddit/post.ts '{\"search\":\"playwright\"}'",
    "reddit:join-subreddit": "npm run reddit:run subreddit/join.ts '{\"search\":\"business\"}'",
    "local:x-retweet": "npm run node:ts src/local.ts -- x retweet.js '{\"search\":\"grok\"}'",
    "facebook:run": "npm run node:ts src/local.ts -- facebook",
    "facebook:login-credentials": "npm run facebook:run login/credentials.ts '{\"email\":\"example@gmail.com\", \"password\":\"pass@word\"}'",
    "facebook:keyword-search": "npm run facebook:run post/keyword-search.ts '{\"search\":\"marvel\"}'",
    "facebook:share-post": "npm run facebook:run post/share-post.ts '{\"search\":\"stranger things\"}'",
    "facebook:reply-post": "npm run facebook:run post/reply-post.ts '{\"search\":\"tom cruise\"}'",
    "facebook:create-post": "npm run facebook:run post/create-post.js '{\"postText\":\"Donald trump tarrifs\"}'",
    "facebook:love-post": "npm run facebook:run post/love-post.js '{\"search\":\"ipl\"}'",
    "build": "tsc",
    "build:prod": "npm run clean && tsc -p tsconfig.prod.json && npm run bundle && npm run prepare-dist",
    "clean": "rm -rf dist",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/bundle.js --external:@playwright/* --external:playwright* --external:chromium-bidi/* --external:*.node",
    "prepare-dist": "cp package.json dist/ && cd dist && npm install --omit=dev --no-package-lock --no-bin-links",
    "test": "playwright test"
  },
  "dependencies": {
    "@playwright/test": "^1.50.1"
  },
  "devDependencies": {
    "@types/node": "22.5.4",
    "ts-node": "^10.9.2",
    "typescript": "5.6.2"
  }
}
