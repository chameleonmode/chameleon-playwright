{
  "name": "chameleon-playwright",
  "version": "1.0.0",
  "description": "Dynamic Playwright test runner",
  "type": "module",
  "scripts": {
    "node:ts": "node --loader ts-node/esm",
    "dev": "npm run node:ts src/index.ts",
    "dev:watch": "nodemon --watch 'src/**/*.ts' --exec 'npm run node:ts' src/index.ts",
    "reddit:run": "npm run node:ts src/local.ts -- reddit",
    "reddit:reply": "npm run reddit:run post/reply.ts",
    "reddit:comment": "npm run reddit:run post/comment.ts",
    "reddit:vote": "npm run reddit:run subreddit/vote.ts",
    "reddit:post": "npm run reddit:run subreddit/post.ts",
    "reddit:join": "npm run reddit:run subreddit/join.ts",
    "reddit:login-credentials": "npm run reddit:run login/credentials.ts '{\"email\":\"example@gmail.com\", \"password\":\"pass@word\"}'",
    "reddit:login-google": "npm run reddit:run login/google.ts '{\"email\":\"example@gmail.com\", \"password\":\"pass@word\"}'",
    "build": "tsc",
    "build:prod": "npm run clean && tsc -p tsconfig.prod.json && npm run bundle && npm run prepare-dist",
    "clean": "rm -rf dist",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/bundle.js --external:@playwright/* --external:playwright* --external:chromium-bidi/* --external:*.node",
    "prepare-dist": "cp package.json dist/ && cd dist && npm install --omit=dev --no-package-lock --no-bin-links",
    "examples:ask": "npm run node:ts tests/examples/ask.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.50.1"
  },
  "devDependencies": {
    "@types/node": "22.5.4",
    "ts-node": "^10.9.2",
    "typescript": "5.6.2"
  }
}
