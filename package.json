{
  "name": "chameleon-playwright",
  "version": "1.0.0",
  "description": "Dynamic Playwright test runner",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "dev:watch": "nodemon --watch 'src/**/*.ts' --exec 'node --loader ts-node/esm' src/index.ts",
    "local:reddit-authentication": "node --loader ts-node/esm src/local.ts ./scripts/reddit/plugins/authentication-credentials.ts .cache/reddit \"{\\\"email\\\":\\\"test@gmail.com\\\", \\\"password\\\":\\\"test@1234\\\"}\"",
    "local:reddit-authentication-google": "node --loader ts-node/esm src/local.ts ./scripts/reddit/plugins/authentication-google.ts .cache/reddit \"{\\\"email\\\":\\\"test@gmail.com\\\", \\\"password\\\":\\\"test@1234\\\"}\"",
    "local:reddit-comment": "node --loader ts-node/esm src/local.ts ./scripts/reddit/plugins/comment.js .cache/reddit \"{\\\"search\\\":\\\"playwright\\\",\\\"comSearch\\\":\\\"playwright\\\"}\"",
    "local:reddit-vote": "node --loader ts-node/esm src/local.ts ./scripts/reddit/plugins/subRedditVote.js .cache/reddit \"{\\\"search\\\":\\\"mumbai\\\", \\\"vote\\\":true}\" ",
    "local:reddit-sub": "node --loader ts-node/esm src/local.ts ./scripts/reddit/plugins/postsubreddit.js .cache/reddit \"{\\\"search\\\":\\\"playwright\\\", \\\"commentTitle\\\":\\\"comment from play\\\", \\\"commentText\\\":\\\"every day is a new learning\\\"}\" ",
    "local:reddit-reply-comment": "node --loader ts-node/esm src/local.ts ./scripts/reddit/plugins/reply-comment.ts .cache/reddit \"{\\\"search\\\":\\\"playwright\\\", \\\"triggerWord\\\":\\\"research\\\"}\"",
    "local:reddit-join-subreddit": "node --loader ts-node/esm src/local.ts ./scripts/reddit/plugins/join-subreddit.ts .cache/reddit \"{\\\"search\\\":\\\"business\\\"}\"",
    "local:x-authentication": "node --loader ts-node/esm src/local.ts ./scripts/x/plugins/authentication-credentials.ts .cache/x \"{\\\"email\\\":\\\"test@gmail.com\\\",\\\"userName\\\":\\\"test\\\", \\\"password\\\":\\\"test@1234\\\"}\"",
    "local:x-authentication-google": "node --loader ts-node/esm src/local.ts ./scripts/x/plugins/authentication-google.ts .cache/x \"{\\\"email\\\":\\\"test@gmail.com\\\", \\\"password\\\":\\\"test@1234\\\"}\"",
    "local:x-keyword-search": "node --loader ts-node/esm src/local.ts ./scripts/x/plugins/keyword-search.ts .cache/x \"{\\\"search\\\":\\\"bcCi\\\"}\"",
    "local:x-retweet-post": "node --loader ts-node/esm src/local.ts ./scripts/x/plugins/retweet-post.ts .cache/x \"{\\\"search\\\":\\\"marveL\\\"}\"",
    "local:x-loveTweet": "node --loader ts-node/esm src/local.ts ./scripts/x/plugins/loveTweet.js .cache/x \"{\\\"search\\\":\\\"zoho\\\"}\" ",
    "local:x-commentTweet": "node --loader ts-node/esm src/local.ts ./scripts/x/plugins/CommentTweet.js .cache/x \"{\\\"tweet\\\":\\\"hello friend\\\"}\" ",
    "local:x-reply-comment": "node --loader ts-node/esm src/local.ts ./scripts/x/plugins/reply-comment.ts .cache/x \"{\\\"search\\\":\\\"IPL\\\", \\\"searchKeyword\\\":\\\"one superb\\\"}\"",
    "local:x-retweet": "node --loader ts-node/esm src/local.ts ./scripts/x/plugins/retweet.js .cache/default '{\"search\":\"grok\"}'",
    "build": "tsc",
    "build:prod": "npm run clean && tsc -p tsconfig.prod.json && npm run bundle && npm run prepare-dist",
    "clean": "rm -rf dist",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/bundle.js --external:@playwright/* --external:playwright* --external:chromium-bidi/* --external:*.node",
    "prepare-dist": "cp package.json dist/ && cd dist && npm install --omit=dev --no-package-lock --no-bin-links",
    "test": "playwright test"
  },
  "dependencies": {
    "@playwright/test": "^1.50.1"
  },
  "devDependencies": {
    "@types/node": "22.5.4",
    "ts-node": "^10.9.2",
    "typescript": "5.6.2"
  }
}
