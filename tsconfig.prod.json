{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "sourceMap": false,
    "declaration": false,
    "declarationMap": false,
    "removeComments": true,
    "inlineSources": false,
    "importHelpers": true,     // Use shared runtime helpers
    "noEmitHelpers": true,     // Don't emit helper functions in every file
    "stripInternal": true,     // Strip @internal comments
    "allowImportingTsExtensions": false, // Don't allow importing .ts files directly
    // "resolveJsonModule": true, // Allow importing JSON files
    // "verbatimModuleSyntax": true // Preserve import specifiers
  }
}
