<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>Chameleon.app.Playwright</RootNamespace>
		<AssemblyTitle>Chameleon.app.Playwright</AssemblyTitle>
		<Description>Chameleon.app.Playwright for chameleonmode</Description>
		<Configuration></Configuration>
		<Company></Company>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
