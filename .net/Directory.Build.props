<Project>
	<PropertyGroup>
		<TargetDotnetVersion>net8.0</TargetDotnetVersion>
		<Nullable>enable</Nullable>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>
	
	<PropertyGroup>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<Version>2024.0.0.1</Version>
		<Authors>ezexe</Authors>
		<Product>Chameleon.app.Playwright</Product>
		<Copyright>Copyright © Chameleonmode 2023</Copyright>
		<PackageProjectUrl>https://github.com/chameleonmode/chameleon-playwright</PackageProjectUrl>
		<PackageOutputPath>$(MSBuildProjectDirectory)\..\nuget</PackageOutputPath>
	</PropertyGroup>
</Project>
